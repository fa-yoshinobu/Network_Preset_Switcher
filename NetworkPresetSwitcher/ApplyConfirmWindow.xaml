<Window x:Class="NetworkPresetSwitcher.ApplyConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Msg.ConfirmTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushSurface}">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="AdapterText" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap" />

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Apply.Column.Item}" Style="{StaticResource SubtleText}" FontSize="12" Margin="8,0,0,0" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Apply.Column.Current}" Style="{StaticResource SubtleText}" FontSize="12" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="{DynamicResource Apply.Column.After}" Style="{StaticResource SubtleText}" FontSize="12" Margin="8,0,0,0" />
        </Grid>
        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <ItemsControl x:Name="DiffList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="0,7" BorderBrush="#EEF1F5" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LabelText" Text="{Binding Label}" FontSize="12" Margin="8,0,0,0" />
                                <TextBlock x:Name="CurrentText" Grid.Column="1" Text="{Binding Current}" FontFamily="{StaticResource AppFontMono}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AfterText" Grid.Column="2" Text="{Binding After}" FontFamily="{StaticResource AppFontMono}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BrushChangedLight}" />
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="AfterText" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="CurrentText" Property="Foreground" Value="{StaticResource BrushMuted}" />
                                <Setter TargetName="CurrentText" Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Background="{StaticResource BrushWarningLight}" CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
            <TextBlock x:Name="WarningText" FontSize="12" Foreground="#6B4A10" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SkipCheckBox"
                      Content="{DynamicResource Apply.SkipConfirmWired}"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="0,0,12,0" />
            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource GhostButton}" MinWidth="110" Margin="0,0,8,0"
                    Content="{DynamicResource Main.Button.Cancel}" IsCancel="True" />
            <Button x:Name="ApplyButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    Content="{DynamicResource Apply.Button.Confirm}" Click="OnApplyClick" />
        </Grid>
    </StackPanel>
</Window>
